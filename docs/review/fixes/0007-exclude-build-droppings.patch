diff --git a/tools/test_no_python.py b/tools/test_no_python.py
index 6130370..f2668f2 100644
--- a/tools/test_no_python.py
+++ b/tools/test_no_python.py
@@ -161,6 +161,19 @@ with tempfile.TemporaryDirectory() as d:
