+    note = os.path.join(d, "READ ME - shared plans.txt")
+    if not os.path.exists(note):
+        try:
+            with open(note, "w", encoding="utf-8") as f:
+                f.write(SHARED_README)
+        except OSError:
+            pass
+    return d
+
